# Optional: track estimated remaining = funded - studio spend
BYTEPLUS_FUNDED_BUDGET_USD=
BYTEPLUS_LOW_BALANCE_USD=5
BYTEPLUS_DAILY_BUDGET_USD=
BYTEPLUS_MONTHLY_BUDGET_USD=

MEDIA_SIGNING_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
STUDIO_PASSWORD=change-me-strong-password
