# Copy to .dev.vars for local wrangler dev. Never commit real values.

BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=dreamina-seedance-2-5-260628
BYTEPLUS_BILLING_MODE=MODELARK_TOKEN
BYTEPLUS_TOKEN_PRICE_NO_VIDEO=10.70
