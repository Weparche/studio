{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nepar-series-studio",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "a0ec5e0ddb36f340bf00d1520dfa7f2b",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nepar-series-studio-db",
      "database_id": "f7a688b6-fa0d-4819-8188-1130c6905f4e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nepar-series-studio-media"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "APP_NAME": "NEPAR Series Studio",
    "APP_VERSION": "1.0.0",
    "BYTEPLUS_BASE_URL": "https://ark.ap-southeast.bytepluses.com/api/v3",
    "BYTEPLUS_MODEL": "dreamina-seedance-2-5-260628",
    "BYTEPLUS_BILLING_MODE": "MODELARK_TOKEN",
    "BYTEPLUS_TOKEN_PRICE_NO_VIDEO": "10.70",
    "BYTEPLUS_TOKEN_PRICE_WITH_VIDEO": "6.40",
    "BYTEPLUS_BILLING_CENTER_URL": "https://console.byteplus.com/finance/overview",
    "BYTEPLUS_ADD_FUNDS_URL": "https://console.byteplus.com/finance/fund",
    "BYTEPLUS_CONSOLE_URL": "https://console.byteplus.com/ark",
    "DEFAULT_RESOLUTION": "480p",
    "DEFAULT_ASPECT_RATIO": "9:16",
    "DEFAULT_DURATION": "15",
    "DEFAULT_GENERATE_AUDIO": "true",
    "DEFAULT_RETURN_LAST_FRAME": "true"
  },
  "routes": [
    {
      "pattern": "studio.nepar.hr",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
