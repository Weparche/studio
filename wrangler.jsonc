{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nepar-series-studio",
  "main": "src/server/public-landing.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "studio.nepar.hr",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}